---
interface Props {
  slug: string;
  title?: string;
  width?: number;
  height?: number;
  poster?: string;
  threads?: boolean;
}

const { slug, title = slug, width = 960, height = 540, poster, threads = false } = Astro.props;
const src = `/games/${slug}/`;
const posterStyle = poster ? `background-image: url(${poster})` : undefined;
---
<figure class="game" style={`aspect-ratio: ${width} / ${height};`}>
  {threads ? (
    <a class="game-launch" href={src} target="_blank" rel="noopener" style={posterStyle}>
      <span class="game-button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path></svg>
        Otwórz „{title}” w nowej karcie
      </span>
      <span class="game-caption">ta gra działa tylko w osobnej karcie</span>
    </a>
  ) : (
    <button type="button" class="game-launch" data-src={src} data-title={title} style={posterStyle}>
      <span class="game-button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"></polygon></svg>
        Graj
      </span>
      <span class="game-caption">{title} · ładuje się dopiero po kliknięciu</span>
    </button>
  )}
</figure>
{!threads && (
  <p class="game-fullscreen">
    <a href={src}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"></path></svg>
      pełny ekran
    </a>
  </p>
)}

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.game button.game-launch')) {
    button.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = button.dataset.src!;
      iframe.title = button.dataset.title ?? '';
      iframe.allow = 'fullscreen; gamepad; autoplay';
      button.replaceWith(iframe);
      iframe.focus();
    }, { once: true });
  }
</script>
