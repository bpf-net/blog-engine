---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GamePlayer from '../../components/GamePlayer.astro';
import { getGames, gameSrc, type GameEntry } from '../../lib/games';
import { getDevlog, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const games = await getGames();
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

interface Props {
  game: GameEntry;
}

const { game } = Astro.props;
const { data } = game;
const { Content } = await render(game);
const hasBody = !!game.body?.trim();
const devlog = await getDevlog(game.id);
const info = [
  ['Engine', data.engine],
  ['Platform', data.platform],
  ['Genre', data.genre],
  ['Version', data.version, true],
  ['Updated', data.updated && formatDate(data.updated), true],
].filter((row): row is [string, string, boolean?] => !!row[1]);
const hasAside = info.length > 0 || !!data.feedback;
---
<Base title={data.title} description={data.description}>
  <p class="breadcrumb"><a href="/">~</a> / games / {game.id}</p>
  <article class="game-page">
    <header class="game-page-header">
      <div>
        <h1>{data.title}</h1>
        <p class="game-page-lead">{data.description}</p>
      </div>
      {(data.status || data.draft) && (
        <span class="pill tone-amber">{[data.status, data.draft && 'draft'].filter(Boolean).join(' · ')}</span>
      )}
    </header>
    {data.mobileNote && <p class="mobile-note">{data.mobileNote}</p>}
    <GamePlayer src={gameSrc(game)} title={data.title} caption={data.engine} width={data.width} height={data.height} threads={data.threads} />
    <div class="game-page-body">
    <div class="game-page-main">
      {hasBody && (
        <section aria-labelledby="h-about-game">
          <h2 id="h-about-game">About the game</h2>
          <div class="prose">
            <Content />
          </div>
        </section>
      )}
      {data.controls.length > 0 && (
        <section aria-labelledby="h-controls">
          <h2 id="h-controls">Controls</h2>
          <ul class="controls">
            {data.controls.map((c) => (
              <li>
                <span class="controls-keys">{c.keys.map((k) => <kbd>{k}</kbd>)}</span>
                <span class="controls-action">{c.action}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
      {devlog.length > 0 && (
        <section aria-labelledby="h-devlog">
          <h2 id="h-devlog">Devlog</h2>
          <ol class="devlog">
            {devlog.map((post, i) => (
              <li>
                <a href={`/blog/${post.id}/`} class="devlog-row">
                  <span class="devlog-meta">#{i + 1} · {formatDate(post.data.pubDate)}</span>
                  <span class="devlog-title">{post.data.title}</span>
                  {post.data.draft && <span class="draft-label">draft</span>}
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>
    {hasAside && (
      <aside class="game-info" aria-label="About this game">
        {info.length > 0 && (
          <dl>
            {info.map(([label, value, mono]) => (
              <div>
                <dt>{label}</dt>
                <dd class:list={{ mono }}>{value}</dd>
              </div>
            ))}
          </dl>
        )}
        {data.feedback && <a href={data.feedback} class="btn game-info-feedback">Report a bug / feedback</a>}
      </aside>
    )}
    </div>
  </article>
</Base>
