---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PostList from '../components/PostList.astro';
import GameCards from '../components/GameCards.astro';
import ModuleCards from '../components/ModuleCards.astro';
import Callout from '../components/Callout.astro';
import { getPosts } from '../lib/posts';
import { loadSiteConfig } from '../lib/site';

const { hero, callout } = loadSiteConfig();
const posts = await getPosts();
// With a hero, its headline is the page's h1 and the post list heading drops to h2.
const ListHeading = hero ? 'h2' : 'h1';
---
<Base>
  {hero && <Hero hero={hero} />}
  <section id="latest" class:list={['home', { 'home-after-hero': hero }]} aria-labelledby="h-posts">
    <div class="section-head">
      <ListHeading id="h-posts">Latest posts</ListHeading>
    </div>
    <PostList posts={posts} />
  </section>
  <GameCards />
  <ModuleCards />
  {callout && <Callout callout={callout} />}
</Base>
