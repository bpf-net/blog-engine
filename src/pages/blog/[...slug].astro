---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import { getPosts, formatDate, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <p class="breadcrumb"><a href="/">~</a> / blog / {post.id}</p>
  <article class="post">
    <header class="post-header">
      <Tags tags={post.data.tags} class="post-tags" />
      <h1>{post.data.title}</h1>
      <p class="post-lead">{post.data.description}</p>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.draft && <span class="draft-label">draft</span>}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
