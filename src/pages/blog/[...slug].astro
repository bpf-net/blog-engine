---
import { render, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import Tldr from '../../components/Tldr.astro';
import Toc from '../../components/Toc.astro';
import RelatedModule from '../../components/RelatedModule.astro';
import { getPosts, formatDate, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  // getPosts() is newest first: the older neighbour is "previous", the newer one "next".
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
// The table of contents (and its small script) only on posts with at least two sections.
const tocHeadings = headings.filter((h) => h.depth === 2);
const showToc = tocHeadings.length >= 2;
const related = post.data.module ? await getEntry(post.data.module) : undefined;
const hasAside = showToc || !!related;
---
<Base title={post.data.title} description={post.data.description}>
  <p class="breadcrumb"><a href="/">~</a> / blog / {post.id}</p>
  <article class="post">
    <header class="post-header">
      <Tags tags={post.data.tags} class="post-tags" />
      <h1>{post.data.title}</h1>
      <p class="post-lead">{post.data.description}</p>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.draft && <span class="draft-label">draft</span>}
      </p>
    </header>
    <div class:list={['post-body', { 'has-aside': hasAside }]}>
      <div class="prose">
        {post.data.tldr && <Tldr text={post.data.tldr} />}
        <Content />
      </div>
      {hasAside && (
        <aside class="post-aside" aria-label="About this post">
          <div class="post-aside-inner">
            {showToc && <Toc headings={tocHeadings} />}
            {related && <RelatedModule module={related} />}
          </div>
        </aside>
      )}
    </div>
  </article>
  {(prev || next) && (
    <nav class="post-nav" aria-label="More posts">
      {prev && (
        <a href={`/blog/${prev.id}/`} class="post-nav-link post-nav-prev" rel="prev">
          <span class="post-nav-label">← previous</span>
          <span class="post-nav-title">{prev.data.title}</span>
        </a>
      )}
      {next && (
        <a href={`/blog/${next.id}/`} class="post-nav-link post-nav-next" rel="next">
          <span class="post-nav-label">next →</span>
          <span class="post-nav-title">{next.data.title}</span>
        </a>
      )}
    </nav>
  )}
</Base>
