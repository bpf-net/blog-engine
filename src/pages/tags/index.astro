---
import Base from '../../layouts/Base.astro';
import { getTags, tagHref } from '../../lib/posts';
import { loadSiteConfig } from '../../lib/site';

const tags = await getTags();
const { tagTones } = loadSiteConfig();
---
<Base title="Tags" description="All tags and how many posts use them.">
  <section class="home" aria-labelledby="h-tags">
    <div class="section-head">
      <h1 id="h-tags">Tags</h1>
    </div>
    {tags.length === 0 ? (
      <p class="empty">No tags yet.</p>
    ) : (
      <ul class="tag-cloud">
        {tags.map(({ tag, posts }) => (
          <li>
            <a href={tagHref(tag)} class={`tone-${tagTones[tag] ?? 'accent'}`}>#{tag}</a>
            <span class="tag-count">{posts.length}</span>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
